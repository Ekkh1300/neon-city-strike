# ----------------------------------------------------------------- REQUIRED
# your domain, pointing at this server's IP
GAME_DOMAIN=game.example.com

# where Let's Encrypt sends expiry warnings
LETSENCRYPT_EMAIL=you@example.com

# ----------------------------------------------------------------- SECRETS
# random letters/numbers, no spaces. Generate with:
#   openssl rand -base64 18 | tr -d '/+=' | head -c 24
PEERJS_KEY=CHANGE_ME_PEERJS_RANDOM_KEY

# the TURN password, must match turnserver.conf
TURN_USER=ncs
TURN_PASS=CHANGE_ME_RANDOM_PASSWORD
